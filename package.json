    "verify:dist": "node scripts/verify-dist.mjs",
    "check": "pnpm run build && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.25.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
