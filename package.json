{
  "name": "ai-scriptwriter",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin-based AI duanju scriptwriter",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": { "node": ">=22" },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
